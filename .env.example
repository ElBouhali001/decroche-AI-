OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_FR_VOICE_ID=
ELEVENLABS_EN_VOICE_ID=
# small: ~1.3 s per call turn on a Mac CPU. large-v3-turbo is more accurate
# but takes ~4.4 s per turn on CPU; use it only with a GPU.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=auto
